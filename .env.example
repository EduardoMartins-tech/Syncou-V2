# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string from Railway.
DATABASE_URL=

# JWT_SECRET: Secret for signing JWT tokens.
JWT_SECRET=syncou-super-secret-key-has-to-be-secure-1234

# E-mail provider settings for real production emails (Optional). 
# If empty, the app will log Ethereal email test links to the server console.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=false

# RECAPTCHA_SECRET_KEY: Secret key for Google reCAPTCHA server-side verification
RECAPTCHA_SECRET_KEY=

# VITE_RECAPTCHA_SITE_KEY: Public site key for Google reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=

# FIREBASE_SERVICE_ACCOUNT_BASE64: Base64 string of the Firebase Service Account Key JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=

# VITE_FIREBASE_VAPID_KEY: Firebase Web Push Certificate Key Pair (VAPID)
VITE_FIREBASE_VAPID_KEY=

# CRON_SECRET: Secret key required in x-cron-secret header for external cron HTTP triggers
CRON_SECRET=
